# yeul pc setup loader (fast 11-13) - password unlocks the setup script
$ErrorActionPreference = 'Stop'
$pw = [Runtime.InteropServices.Marshal]::PtrToStringBSTR([Runtime.InteropServices.Marshal]::SecureStringToBSTR((Read-Host 'Password' -AsSecureString)))
$d = [Convert]::FromBase64String('')
$k = New-Object Security.Cryptography.Rfc2898DeriveBytes($pw, [byte[]]$d[0..15], 200000)
$a = [Security.Cryptography.Aes]::Create(); $a.Mode = 'CBC'; $a.Padding = 'PKCS7'; $a.Key = $k.GetBytes(32); $a.IV = [byte[]]$d[16..31]
try { $pt = $a.CreateDecryptor().TransformFinalBlock($d, 32, $d.Length - 32) } catch { Write-Host 'Wrong password' -ForegroundColor Red; return }
$s = [Text.Encoding]::UTF8.GetString($pt)
if (-not $s.StartsWith('YEULOK')) { Write-Host 'Wrong password' -ForegroundColor Red; return }
$f = Join-Path $env:TEMP 'yeul-pc-setup.ps1'
[IO.File]::WriteAllText($f, $s.Substring(7), (New-Object Text.UTF8Encoding $true))
$adm = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
if ($adm) { & powershell -NoProfile -ExecutionPolicy Bypass -File $f } else { Start-Process powershell -Verb RunAs -ArgumentList "-NoProfile -ExecutionPolicy Bypass -NoExit -File `"$f`"" }
